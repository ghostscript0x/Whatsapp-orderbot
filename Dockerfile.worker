# syntax=docker/dockerfile:1.7
# BullMQ worker image. Runs the TypeScript sources with tsx (resolves the "@/..." tsconfig paths),
# so there is no separate compile step to drift from the app build.
# Also used by the one-shot `migrate` service (`prisma migrate deploy`), since it has the prisma CLI.

ARG NODE_VERSION=22.12.0

FROM node:${NODE_VERSION}-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY prisma ./prisma
# Full install: tsx and the prisma CLI are devDependencies.
RUN npm ci --no-audit --no-fund && npx prisma generate

# Whole source tree (filtered by .dockerignore): lib/ imports reach auth.ts and friends at the repo root.
COPY . .

ENV NODE_ENV=production
RUN chown -R node:node /app
USER node

# SIGTERM is handled in worker/index.ts (closes workers gracefully); exec form so node receives it.
CMD ["node_modules/.bin/tsx", "worker/index.ts"]
