# Copy to .env and fill in. Never commit .env.
DATABASE_URL=file:./dev.db
# SQLite for now (paths are relative to prisma/). To move to Postgres later: set
# provider = "postgresql" in prisma/schema.prisma, regenerate the migration, and use
# postgresql://user:pass@host:5432/orderbot URLs here.
# Separate DB for integration tests (created automatically by tests/global-setup.ts)
TEST_DATABASE_URL=file:./test.db
REDIS_URL=redis://localhost:6379

# Public https URL of this app. OpenWA rejects localhost webhook URLs; use a tunnel in dev.
APP_URL=http://localhost:3000

AUTH_SECRET=   # openssl rand -base64 32
# 32 bytes, base64. Used for AES-256-GCM encryption of secrets at rest.
ENCRYPTION_KEY=   # openssl rand -base64 32

OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Only for openai/gpt-oss* models: low | medium | high
GROQ_REASONING_EFFORT=medium
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_TIMEOUT_MS=

S3_ENDPOINT=http://localhost:8333
S3_REGION=auto
S3_BUCKET=products
S3_ACCESS_KEY=local
S3_SECRET_KEY=local
S3_PUBLIC_URL=http://localhost:8333/products

# Optional: email (password reset, invites, disconnect alerts). If unset, emails are logged to the console.
SMTP_URL=
EMAIL_FROM=no-reply@example.com

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Production compose only (docker-compose.prod.yml)
APP_DOMAIN=
POSTGRES_PASSWORD=
